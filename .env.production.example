# Production environment — copy to your Vercel project's Environment Variables.
# Values in <> are placeholders — fill in your real values. Every NEXT_PUBLIC_*
# var is safe to expose; everything else is server-only.

# --- Supabase (fresh production project) ---
NEXT_PUBLIC_SUPABASE_URL=<https://xxxxxxxx.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
SUPABASE_SERVICE_ROLE_KEY=<secret key — server-only, never expose>

# --- App URL / inbound email domain ---
# The inbound subdomain must have an MX record pointing at mx.sendgrid.net.
INBOUND_EMAIL_WEBHOOK_SECRET=<long random string>
INBOUND_EMAIL_DOMAIN=invoices.ufirst.co

# --- Invoice extraction (OpenRouter) ---
OPENROUTER_API_KEY=<sk-or-...>
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Transactional email (Resend) ---
RESEND_API_KEY=<re_...>
RESEND_FROM_EMAIL=<from@yourdomain.com>

# --- QuickBooks Online (Intuit Developer app) ---
QBO_CLIENT_ID=<Intuit app client id>
QBO_CLIENT_SECRET=<Intuit app client secret>
QBO_REDIRECT_URI=https://flow.ufirst.co/api/qbo/callback

# --- Billing (manual billing v1: suggested monthly charge = invoices × rate) ---
BILLING_RATE_PER_INVOICE=5.00
