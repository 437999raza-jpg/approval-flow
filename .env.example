# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the client. Used by the
# inbound-email webhook to write invoices on behalf of a sender who isn't
# a logged-in Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret appended as ?token= on the inbound email webhook URL you
# give to SendGrid, so random internet traffic can't post fake invoices.
INBOUND_EMAIL_WEBHOOK_SECRET=

# Subdomain you point at SendGrid's MX (see README) e.g. invoices.yourapp.com.
# Each org's forwarding address is {org_inbound_token}@this-domain.
INBOUND_EMAIL_DOMAIN=invoices.yourapp.com

# Robust invoice extraction (fields + line items) via OpenRouter.
# Required for extraction to run; without it, extraction silently no-ops.
OPENROUTER_API_KEY=
# Optional — any OpenRouter model id, e.g. "anthropic/claude-sonnet-4.5",
# "openai/gpt-4o", "google/gemini-2.0-flash-001". Defaults to
# "anthropic/claude-sonnet-4.5" when unset.
OPENROUTER_MODEL=

# Outbound email for @mention notifications (Discussion), via Resend
# (resend.com). Both optional — without them, mentions still get an
# in-app notification, just no email. RESEND_FROM_EMAIL must be an
# address on a domain you've verified in Resend (or their
# onboarding@resend.dev test address, which only delivers to your own
# account email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Base URL used to build the "open this invoice" link in mention emails.
# Defaults to http://localhost:3210 when unset (fine for local dev).
NEXT_PUBLIC_APP_URL=

# QuickBooks Online (Intuit Developer app) — used for the QBO sync.
# Create an app at developer.intuit.com; set the Redirect URI below in the
# app's "Redirect URIs" too (exact match required).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3210/api/qbo/callback

# Comma-separated emails allowed to create new organizations (tenants) at
# /admin/organizations. This is cross-org — separate from any org's own
# "admin" role. Leave unset to hide/disable that page entirely.
PLATFORM_ADMIN_EMAILS=
