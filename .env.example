# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the client. Used by the
# inbound-email webhook to write invoices on behalf of a sender who isn't
# a logged-in Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret appended as ?token= on the inbound email webhook URL you
# give to SendGrid, so random internet traffic can't post fake invoices.
INBOUND_EMAIL_WEBHOOK_SECRET=

# Subdomain you point at SendGrid's MX (see README) e.g. invoices.yourapp.com.
# Each org's forwarding address is {org_inbound_token}@this-domain.
INBOUND_EMAIL_DOMAIN=invoices.yourapp.com

# Used to auto-extract vendor/amount/due date from uploaded invoices.
# Optional: if unset, invoices are just created with those fields blank.
ANTHROPIC_API_KEY=
